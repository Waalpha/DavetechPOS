# NODE_ENV: Set to 'production' for live deployments.
NODE_ENV=production

# PORT: The port your server listens on. Render automatically injects this (defaults to 10000 on Render).
PORT=3000

# GEMINI_API_KEY: Optional/Required for Gemini AI server-side features.
GEMINI_API_KEY=

# APP_URL: The public base URL of your deployed application (e.g. https://davetech-pos.onrender.com).
APP_URL=

